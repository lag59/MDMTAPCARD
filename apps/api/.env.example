DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mdmtapcard
ALLOWED_ORIGINS=["http://localhost:3000"]
PROFILE_BASE_URL=https://tap.mdmcreation.com

# Cloudflare R2 or AWS S3
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

# Local upload fallback (used only when STORAGE_BUCKET is empty)
UPLOAD_DIR=uploads
API_PUBLIC_URL=http://localhost:8000

# Square payments
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
# Optional override; defaults by environment when blank
SQUARE_API_BASE_URL=
# Optional checkout redirect back to web app (e.g. http://localhost:3000/admin/orders)
SQUARE_CHECKOUT_REDIRECT_URL=

# Shippo shipping labels
SHIPPO_API_TOKEN=
SHIPPO_API_BASE_URL=https://api.goshippo.com

# Ship-from address used to purchase Shippo labels
SHIP_FROM_NAME=MDM Creation
SHIP_FROM_COMPANY=MDM Creation
SHIP_FROM_STREET1=
SHIP_FROM_STREET2=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_ZIP=
SHIP_FROM_COUNTRY=US
SHIP_FROM_PHONE=
SHIP_FROM_EMAIL=

# Default parcel dimensions for a programmed NFC card/button mailer
SHIP_PARCEL_LENGTH_IN=6.0
SHIP_PARCEL_WIDTH_IN=4.0
SHIP_PARCEL_HEIGHT_IN=1.0
SHIP_PARCEL_WEIGHT_OZ=3.0

# Lead phone OTP verification
OTP_PROVIDER=mock
OTP_CODE_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_TWILIO_ACCOUNT_SID=
OTP_TWILIO_AUTH_TOKEN=
OTP_TWILIO_FROM_NUMBER=

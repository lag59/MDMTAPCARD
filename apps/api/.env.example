DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mdmtapcard
ALLOWED_ORIGINS=["http://localhost:3000"]
PROFILE_BASE_URL=https://tap.mdmcreation.com

# Cloudflare R2 or AWS S3
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

# Local upload fallback (used only when STORAGE_BUCKET is empty)
UPLOAD_DIR=uploads
API_PUBLIC_URL=http://localhost:8000

# Square payments
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
# Optional override; defaults by environment when blank
SQUARE_API_BASE_URL=
# Optional checkout redirect back to web app (e.g. http://localhost:3000/admin/orders)
SQUARE_CHECKOUT_REDIRECT_URL=

# Shippo shipping labels
SHIPPO_API_TOKEN=
SHIPPO_API_BASE_URL=https://api.goshippo.com

# Ship-from address used to purchase Shippo labels
SHIP_FROM_NAME=MDM Creation
SHIP_FROM_COMPANY=MDM Creation
SHIP_FROM_STREET1=
SHIP_FROM_STREET2=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_ZIP=
SHIP_FROM_COUNTRY=US
SHIP_FROM_PHONE=
SHIP_FROM_EMAIL=

# Default parcel dimensions for a programmed NFC card/button mailer
SHIP_PARCEL_LENGTH_IN=6.0
SHIP_PARCEL_WIDTH_IN=4.0
SHIP_PARCEL_HEIGHT_IN=1.0
SHIP_PARCEL_WEIGHT_OZ=3.0

# Lead phone OTP verification
OTP_PROVIDER=mock
OTP_CODE_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_TWILIO_ACCOUNT_SID=
OTP_TWILIO_AUTH_TOKEN=
OTP_TWILIO_FROM_NUMBER=

# Twilio SMS for texting login credentials to clients.
# Get these from https://console.twilio.com (Account SID + Auth Token) and buy
# an SMS-capable number under Phone Numbers. Leave blank to fall back to the
# OTP_TWILIO_* values above. Set SMS_PROVIDER=mock to log messages instead of
# sending (useful for local testing).
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Default temporary password used when creating a user without entering one.
# Leave blank to auto-generate a strong random password each time.
DEFAULT_TEMP_PASSWORD=

# Social content system (Phase 1). Fernet key encrypts OAuth tokens at rest.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank to derive a key from SECRET_KEY (set a dedicated key in production).
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_SYNC_ENABLED=false
# Origins allowed to call the public gallery API directly from a browser.
# Server-side (Netlify Function) callers do not need this. Use "*" or a CSV list.
GALLERY_ALLOWED_ORIGINS=*
